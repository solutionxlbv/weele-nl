---
// Fonts are self-hosted (no requests to Google, no visitor IPs leaving the site).
// Only the weights that the CSS actually uses are imported.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { heroImage, HERO_FALLBACK_URL } from '../lib/hero';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string | null;
  ogImage?: string;
  noindex?: boolean;
}

// Social preview: a self-hosted 1200px JPEG when the hero photo is in the repo,
// otherwise the external Unsplash URL (previous behaviour).
const defaultOgImage = heroImage
  ? new URL(
      (await getImage({ src: heroImage, width: 1200, format: 'jpg', quality: 80 })).src,
      Astro.site,
    ).href
  : HERO_FALLBACK_URL;

const {
  title = 'Henk van der Weele | Interim IT & Software Leadership',
  description = 'Henk van der Weele: onafhankelijk interim IT- en softwareleider voor engineering teams, productontwikkeling en software delivery. Ervaring in banking, luchtvaart, energie en publieke sector.',
  canonical = 'https://www.weele.nl/',
  ogImage = defaultOgImage,
  noindex = false,
} = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.weele.nl/#henk',
      name: 'Henk van der Weele',
      url: 'https://www.weele.nl/',
      jobTitle: 'Interim IT & Software Leader',
      description:
        'Onafhankelijk interim consultant voor engineering leadership, productontwikkeling en software delivery.',
      sameAs: ['https://www.linkedin.com/in/weele/'],
      knowsAbout: [
        'Software engineering leadership',
        'Engineering management',
        'Software delivery',
        'Product development',
        'IT transformation',
        'Banking',
        'Luchtvaart',
        'Energie',
        'Publieke sector',
      ],
      worksFor: { '@id': 'https://www.weele.nl/#business' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.weele.nl/#business',
      name: 'SolutionXL BV',
      url: 'https://www.weele.nl/',
      description:
        'Onafhankelijke consultancy en tijdelijke versterking voor IT, software engineering, productontwikkeling en software delivery.',
      founder: { '@id': 'https://www.weele.nl/#henk' },
      areaServed: { '@type': 'Country', name: 'Nederland' },
      telephone: '+31-6-46741921',
      email: 'info@solutionxl.nl',
    },
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Henk van der Weele" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfaf8" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Henk van der Weele | SolutionXL BV" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Onafhankelijke interim consultancy voor engineering leadership, productontwikkeling en software delivery in complexe organisaties."
    />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="Interim IT-leadership, engineering management, productontwikkeling en software delivery. Onafhankelijk via SolutionXL BV."
    />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
