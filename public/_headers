/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro build output (CSS, fonts, optimised images): file names contain a
# content hash, so these can be cached for a year without going stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name assets: cache for a day, then revalidate.
/assets/*.svg
  Cache-Control: public, max-age=86400

# The CV is replaced under the same file name: always revalidate,
# so recruiters never get an outdated version from their browser cache.
/assets/*.pdf
  Cache-Control: public, max-age=0, must-revalidate

/favicon*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
